# Prisma pool: feed-service ranker fans out ~15 parallel queries
# (candidates, trending, explore, social signals, suggested users/courses/quizzes,
# 5 personalization lookups, etc.). With limit=2 they queue and trip soft-timeouts.
# Supabase free tier via pgbouncer transaction pooler (port 6543) supports 200
# client conns, so 10/service is safe even with multiple services running.
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT=15
# DB keepalive enabled to avoid TCP+TLS handshake on every cold connection.
# Singapore RTT is ~30-80ms warm, ~300-700ms cold — keepalive keeps it warm.
DISABLE_DB_KEEPALIVE=0
SKIP_DB_MIGRATE=0
SKIP_MESSAGING_SERVICE=1
