# Stunity Web — copy all variables into Vercel (Project → Settings → Environment Variables).
# Use Production scope. Do not commit real secrets here; NEXT_PUBLIC_* are baked into the client at build time.
#
# Phase 0 (2026-07-23) consolidated the 16 individual services into 2 deployables
# (engagement-api, academic-api) + ai-service, unchanged. Phase D (2026-07-24) mapped
# them to custom domains, so every service below now resolves to one of 3 base URLs.

# --- engagement-api: auth, feed, learn, messaging, notification, analytics ---
NEXT_PUBLIC_AUTH_SERVICE_URL=https://api.stunity.app
NEXT_PUBLIC_FEED_SERVICE_URL=https://api.stunity.app
NEXT_PUBLIC_MESSAGING_SERVICE_URL=https://api.stunity.app
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=https://api.stunity.app
NEXT_PUBLIC_ANALYTICS_SERVICE_URL=https://api.stunity.app
NEXT_PUBLIC_LEARN_SERVICE_URL=https://api.stunity.app

# --- academic-api: school, student, teacher, class, subject, grade, attendance, timetable, club ---
NEXT_PUBLIC_SCHOOL_SERVICE_URL=https://academic.stunity.app
NEXT_PUBLIC_STUDENT_SERVICE_URL=https://academic.stunity.app
NEXT_PUBLIC_TEACHER_SERVICE_URL=https://academic.stunity.app
NEXT_PUBLIC_CLASS_SERVICE_URL=https://academic.stunity.app
NEXT_PUBLIC_SUBJECT_SERVICE_URL=https://academic.stunity.app
NEXT_PUBLIC_GRADE_SERVICE_URL=https://academic.stunity.app
NEXT_PUBLIC_ATTENDANCE_SERVICE_URL=https://academic.stunity.app
NEXT_PUBLIC_TIMETABLE_SERVICE_URL=https://academic.stunity.app
# club-service's routes are unprefixed internally and collide with the dedicated
# modules, so academic-api mounts it under /club — keep that in the base URL.
NEXT_PUBLIC_CLUB_SERVICE_URL=https://academic.stunity.app/club

# --- ai-service: unchanged by Phase 0 ---
NEXT_PUBLIC_AI_SERVICE_URL=https://ai.stunity.app

# Optional: override feed base URL if different from NEXT_PUBLIC_FEED_SERVICE_URL
# NEXT_PUBLIC_FEED_API_URL=

# Quiz War feed banner + /quiz-wars/* client calls (must match backend QUIZ_WAR_ENABLED)
# NEXT_PUBLIC_QUIZ_WAR_ENABLED=false

# Legacy / media naming (feed often serves media; set to feed URL if no separate media service)
NEXT_PUBLIC_MEDIA_SERVICE_URL=https://api.stunity.app

# Cloudflare R2 public bucket URL (replace placeholder)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
