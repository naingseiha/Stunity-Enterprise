# API Configuration
# Set this to your backend server IP address based on your network

# Option 1: Localhost (when running backend on same machine as simulator)
# Works for iOS Simulator and Android Emulator
EXPO_PUBLIC_API_HOST=localhost

# Option 2: Your Computer's Local IP on WiFi
# Find your IP: macOS/Linux = ifconfig, Windows = ipconfig
# Example: EXPO_PUBLIC_API_HOST=192.168.1.100

# Option 3: Mobile Hotspot IP (your current setup)
# EXPO_PUBLIC_API_HOST=10.103.61.191

# Option 4: Testing on Physical Device
# Use your computer's IP on the same network
# iPhone/Android on WiFi: Use computer's WiFi IP
# iPhone/Android on Hotspot: Use computer's hotspot IP

# Supabase Realtime (required)
# IMPORTANT:
# - Must use EXPO_PUBLIC_ prefix for Expo runtime access
# - This file lives in apps/mobile (root .env does not auto-populate mobile runtime vars)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Passwordless / Telegram / Passkeys (optional feature flags)
# EXPO_PUBLIC_PASSWORDLESS_AUTH_ENABLED=true
# EXPO_PUBLIC_AUTH_TELEGRAM_OIDC_ENABLED=true
# EXPO_PUBLIC_AUTH_PASSKEYS_ENABLED=true

# Google Sign-In (Signup / Login)
# Create OAuth client IDs in Google Cloud Console. Backend GOOGLE_CLIENT_ID
# (usually the Web client) must accept the same audience as the ID token.
# EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=true
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Facebook Login (Signup / Login)
# Create a Facebook App with Facebook Login. Add redirect URI:
#   stunity://auth/facebook
# Backend needs FACEBOOK_APP_ID + FACEBOOK_APP_SECRET.
# EXPO_PUBLIC_AUTH_FACEBOOK_ENABLED=true
# EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# Crash reporting (Sentry) — optional
# Leave unset to disable: the app no-ops crash reporting without a DSN.
# Get the DSN from your Sentry project (Settings > Client Keys / DSN).
# Only sent from staging/production builds, never from __DEV__.
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# How to find your IP:
# macOS: System Settings > Network > WiFi > Details > IP Address
# OR in terminal: ipconfig getifaddr en0
# Windows: Settings > Network > WiFi > Properties
# Linux: ip addr show
