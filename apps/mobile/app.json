{
  "expo": {
    "name": "Stunity",
    "slug": "stunity-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": [
      "stunity",
      "com.googleusercontent.apps.527589814768-am3vaacsop7elhgup811fmb29c0fb3lb"
    ],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/Stunity.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.stunity.mobile",
      "buildNumber": "14",
      "associatedDomains": [
        "applinks:stunity.app",
        "applinks:www.stunity.app",
        "webcredentials:stunity.app",
        "webcredentials:www.stunity.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Stunity needs camera access to take photos for posts and profile pictures.",
        "NSPhotoLibraryUsageDescription": "Stunity needs photo library access to share photos in posts.",
        "NSMicrophoneUsageDescription": "Stunity needs microphone access to record videos.",
        "NSFaceIDUsageDescription": "Stunity uses Face ID for secure login.",
        "NSLocationWhenInUseUsageDescription": "Stunity needs your location to verify your check-in at school.",
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "newArchEnabled": true
    },
    "android": {
      "package": "app.stunity.mobile",
      "googleServicesFile": "./google-services.json",
      "versionCode": 22,
      "icon": "./assets/android-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "image": "./assets/Stunity.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "stunity.app",
              "pathPrefix": "/posts"
            },
            {
              "scheme": "https",
              "host": "www.stunity.app",
              "pathPrefix": "/posts"
            },
            {
              "scheme": "https",
              "host": "stunity.app",
              "pathPrefix": "/claim"
            },
            {
              "scheme": "https",
              "host": "www.stunity.app",
              "pathPrefix": "/claim"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "newArchEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/Stunity.png",
          "imageWidth": 320
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Stunity to access your camera."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Stunity to access your photos."
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-notifications",
      "expo-video",
      "@sentry/react-native",
      "./plugins/withFmtConstevalFix.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 35
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ccd3aea3-ccae-4bec-964a-bd331b2ff5b3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ccd3aea3-ccae-4bec-964a-bd331b2ff5b3"
    }
  }
}
