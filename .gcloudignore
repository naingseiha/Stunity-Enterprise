# Google Cloud Ignore - Ultra Aggressive
.gcloudignore
.git
.gitignore
node_modules/
**/node_modules/
.next/
**/.next/
dist/
**/dist/
build/
**/build/
.expo/
**/.expo/
ios/
**/ios/
android/
**/android/
.turbo/
**/.turbo/
.vscode/
**/.vscode/
*.log
*.tgz
*.zip
*.db
*.sqlite
.env*
!.env.production.example

# EXCLUDE APPS - Not needed for backend builds
apps/
**/apps/

# Cloud Run Dockerfiles only copy consolidated service sources, shared service
# helpers, and the central Prisma schema. Migration exports and product docs can
# be hundreds of MB and must never be uploaded as Cloud Build context.
scripts/
docs/
/Ebooks/
/*.png
/*.jpg
/*.jpeg
/*.pdf
/*.mp4
/tsconfig.tsbuildinfo
/package-lock.json

/packages/*
!/packages/database/
/packages/database/*
!/packages/database/prisma/

/services/*
!/services/academic-api/
!/services/engagement-api/
!/services/ai-service/
!/services/lib/

# Monorepo specific exclusions
packages/database/node_modules/
services/*/node_modules/

# Media
**/assets/media/
**/public/uploads/
**/uploads/
